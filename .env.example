# ==============================================================================
# speaker-watchdog: Plantilla de Configuración de Entorno
# ==============================================================================

# Directorio del sistema de archivos a vigilar (Ruta absoluta recomendada)
# El servicio buscará archivos con extensión .wav en este directorio.
# Asegúrate de que el usuario ejecutor tenga permisos de lectura y escritura.
WATCHDOG_DIR=/home/danuser2018/workspace/speaker-watchdog/alerts

# Nivel de registro (Logging level): DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Comando o ruta absoluta al ejecutable del reproductor mpv
MPV_PATH=mpv
